# Used by docker compose (variable substitution in compose.yml). Copy to .env and fill in.
# Generate secrets with: openssl rand -hex 32

# --- Database ---
POSTGRES_USER=llms
POSTGRES_DB=llms
POSTGRES_PASSWORD=change-me

# --- Backend ---
SECRET_KEY=change-me
CORS_ORIGINS=http://localhost:5000

# --- Frontend (baked into the browser bundle; must be the host-published backend URL) ---
VITE_API_URL=http://localhost:8020
