# Backend app config, loaded via env_file in compose.yml. Copy to .env and fill in.
# DATABASE_URL, SECRET_KEY and CORS_ORIGINS come from the root .env via compose.

# --- LLM tutor/grader (set LLM_PROVIDER to "groq" or "anthropic", or leave blank to auto-pick) ---
LLM_PROVIDER=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Owner (single env-configured identity that invites admins; both required) ---
OWNER_EMAIL=
OWNER_PASSWORD=

# --- SMTP (password-reset and invite emails) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@llm-foundations.local

# --- Optional tuning ---
FRONTEND_URL=http://localhost:5000
ACCESS_TOKEN_EXPIRE_MINUTES=10080
RESET_TOKEN_EXPIRE_MINUTES=30
OWNER_TOKEN_EXPIRE_MINUTES=30
ADMIN_INVITE_EXPIRE_HOURS=48
ADMIN_TOKEN_EXPIRE_MINUTES=60

# --- Code runner limits (defaults suit Render's free 512 MB instance) ---
KERNEL_MAX=2
KERNEL_IDLE_SECONDS=300
KERNEL_CELL_TIMEOUT=60
